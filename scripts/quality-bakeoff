#!/usr/bin/env bash
# Offline quality only; no wall-clock performance or held-out claim.
set -euo pipefail
cd "$(dirname "$0")/.."
export OMP_NUM_THREADS=2 OMP_THREAD_LIMIT=2 OPENBLAS_NUM_THREADS=2 VECLIB_MAXIMUM_THREADS=2
for candidate in vision-union ppocr-v5-mobile ppocr-v6-small ppocr-v6-tiny; do
  nice -n 10 .venv/bin/python -u -m bench.offline_quality \
    --candidate "$candidate" --split tune --run-id "offline-$candidate-a30" \
    --seconds 5 --D 1 --B 6 --A 30 --padding 0.3 \
    --fast-rate-hz 8 --accurate-rate-hz 4 --fast-width 640 --accurate-width 1280 \
    --motion-mode phase --motion-width 320 --encoder h264_videotoolbox \
    --provider coreml --fast-provider coreml --static-model
done
